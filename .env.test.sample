# Test-deployment config for this 1-machine vast.ai instance.
# wardrobe-system-spec.md §2.3.6 checklist step 8: every IP/port value used, in one
# place, so moving any component to a real separate machine later is an edit here,
# not a code change. On THIS instance these all happen to be 127.0.0.1 (no Docker
# network — see the plan's "Architecture adaptation" note) but nothing in the code
# assumes that; only this file does.
#
# Copy to ${WORKSPACE}/.env and fill in real secrets (already done on this instance;
# this file is the checked-in template, not the live one — do not commit real
# credentials here).

# --- postgres-db --- (data-server only; ai-server must never be given these)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=wardrobe
POSTGRES_USER=wardrobe_app
POSTGRES_PASSWORD=

# --- object-storage (MinIO, S3-compatible) ---
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=          # = MINIO_ROOT_USER on this box (no separate service account created)
MINIO_SECRET_KEY=          # = MINIO_ROOT_PASSWORD
MINIO_RAW_BUCKET=wardrobe-raw
MINIO_ITEMS_BUCKET=wardrobe-items

# --- queue (Redis) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- data-server (the only publicly exposed component) ---
DATA_SERVER_HOST=127.0.0.1
DATA_SERVER_PORT=18080
# Exposed externally via this instance's Caddy edge on external_port 10100
# (container port 8080 was already taken by this instance's Jupyter Terminal
# service — see /etc/portal.yaml "Data Server" entry). Actual reachable URL:
# http://$PUBLIC_IPADDR:$VAST_TCP_PORT_10100/v1/... — read both from
# `vast-capabilities` at runtime, don't hardcode the mapped port.

# --- ai-server (internal only, never exposed) ---
AI_SERVER_HEALTH_PORT=18090
COMFYUI_URL=http://127.0.0.1:18188
ITEM_DETECTOR_URL=http://127.0.0.1:18189
# D0b's detector/SAM/ArcFace device. cuda on this box: measured 18.5s -> 4.6s per
# photo vs cpu, and it fits alongside ComfyUI's ~21GB. Set cpu if VRAM gets tight.
OUTFIT_ITEMS_DEVICE=cuda

# --- pipeline tuning ---
WARDROBE_DEDUP_THRESHOLD=0.90   # D2 cosine-similarity cutoff, not chốt per the spec — tune on real data
MAX_JOB_RETRIES=3

# --- seeded test identity (server/data_server/scripts/seed_test_account.py) ---
# Stands in for the login/session system the spec assumes exists upstream.
TEST_ACCOUNT_ID=
TEST_USER_ID=
TEST_BEARER_TOKEN=
