# Test-deployment config for this 1-machine vast.ai instance.
# wardrobe-system-spec.md §2.3.6 checklist step 8: every IP/port value used, in one
# place, so moving any component to a real separate machine later is an edit here,
# not a code change. On THIS instance these all happen to be 127.0.0.1 (no Docker
# network — see the plan's "Architecture adaptation" note) but nothing in the code
# assumes that; only this file does.
#
# Copy to ${WORKSPACE}/.env and fill in real secrets (already done on this instance;
# this file is the checked-in template, not the live one — do not commit real
# credentials here).

# --- postgres-db --- (data-server only; ai-server must never be given these)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=wardrobe
POSTGRES_USER=wardrobe_app
POSTGRES_PASSWORD=

# --- object-storage (MinIO, S3-compatible) ---
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=          # = MINIO_ROOT_USER on this box (no separate service account created)
MINIO_SECRET_KEY=          # = MINIO_ROOT_PASSWORD
# Presigned-URL addressing. §2.3.4 wants object-storage off the public net, but §1.2 D0
# has Mobile PUT straight to it — on one box both can't hold, so the S3 API is published
# on external_port 10200 with the edge's token auth left ON (Mobile sends the instance
# token as a cookie, which leaves the sigv4-signed query string untouched).
# MINIO_PRESIGN_ENDPOINT is the host:port the signature is computed against and must
# equal what object-storage actually receives in its Host header — Caddy proxies with
# `header_up Host {upstream_hostport}`, hence localhost:9000, not the public address.
# MINIO_PUBLIC_URL is the origin swapped into the URL handed back to Mobile.
# In production (object-storage reachable directly) leave both empty.
MINIO_PRESIGN_ENDPOINT=localhost:9000
MINIO_PUBLIC_URL=http://<public_ip>:<VAST_TCP_PORT_10200>
MINIO_RAW_BUCKET=wardrobe-raw
MINIO_ITEMS_BUCKET=wardrobe-items

# --- queue (Redis) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- data-server (the only publicly exposed component) ---
DATA_SERVER_HOST=127.0.0.1
DATA_SERVER_PORT=18080
# Exposed externally via this instance's Caddy edge on external_port 10100
# (container port 8080 was already taken by this instance's Jupyter Terminal
# service — see /etc/portal.yaml "Data Server" entry). Actual reachable URL:
# http://$PUBLIC_IPADDR:$VAST_TCP_PORT_10100/v1/... — read both from
# `vast-capabilities` at runtime, don't hardcode the mapped port.

# --- ai-server (internal only, never exposed) ---
AI_SERVER_HEALTH_PORT=18090
COMFYUI_URL=http://127.0.0.1:18188
ITEM_DETECTOR_URL=http://127.0.0.1:18189
# D0b's detector/SAM/ArcFace device. Spec §2.3.6 step 5 suggests cpu on a single-GPU box,
# but all three models fit on the 24GB RTX 3090 Ti once ComfyUI is told to leave headroom
# (COMFYUI_RESERVE_VRAM below): measured 4.5s vs ~27s per group photo, and batch
# throughput 29s vs ~41s per image. Set cpu only if the card is smaller.
# NOTE: ArcFace runs on onnxruntime, not torch — it needs onnxruntime-gpu AND the CUDA
# libs on LD_LIBRARY_PATH (see scripts/item_detector.sh), otherwise it silently falls
# back to CPU while this variable still says cuda.
OUTFIT_ITEMS_DEVICE=cuda

# ComfyUI (D1) otherwise expands to fill the whole card and starves the other two GPU
# consumers on this box (D0b detector ~4.1GB, D3 classifier ~2.8GB). Measured peak with
# this set to 4: 24056 MiB of 24564. Raising it to 5 did NOT lower the peak — the other
# processes' torch caching allocators just grow into the slack — but cost 18% throughput.
COMFYUI_RESERVE_VRAM=4

# --- pipeline tuning ---
WARDROBE_DEDUP_THRESHOLD=0.90   # D2 cosine-similarity cutoff, not chốt per the spec — tune on real data
MAX_JOB_RETRIES=3

# --- D0b face reference ---
# The account's registered selfie, uploaded via POST /v1/face-reference/presign +
# PUT /v1/face-reference. Its object key rides in each job-queue ticket (faceRefKey)
# so ai-server can fetch it without being given postgres's address (§2.3.3).
# No env value needed for that path — it lives in accounts.face_ref_key.
#
# TEST ONLY (spec §2.3.7): a fixed reference face shared by every account, so the client
# never has to call /v1/face-reference and starts straight at POST /v1/uploads/presign.
# data-server uploads it to object-storage once at boot (key face/_test_fixture/
# reference.jpg) and uses it for any account that has not registered one of its own —
# an account's own face always wins, so this changes nothing when unset.
# A missing file is only a logged warning; D0b then falls back to largest-person-in-frame.
#
# MUST BE EMPTY IN PRODUCTION. Leaving it set means every user who has not registered a
# face is matched against a stranger's, and their wardrobe fills with that person's clothes.
TEST_FIXED_FACE_REF_IMAGE=/workspace/qie-outfit-comfyui-server/face-image/selfie.jpg

# --- seeded test identity (server/data_server/scripts/seed_test_account.py) ---
# Stands in for the login/session system the spec assumes exists upstream.
TEST_ACCOUNT_ID=
TEST_USER_ID=
TEST_BEARER_TOKEN=
